{
  "name": "@loopcliharness/supervisor",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic supervisor loop: repeatedly runs the first recommended AgentJira task via the single-session runner until none remain.",
  "type": "module",
  "scripts": {
    "start": "tsx loop.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mutation": "stryker run"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
