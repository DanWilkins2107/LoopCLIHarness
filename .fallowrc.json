{
  // maxCyclomatic / maxCognitive are set at the current worst function on main,
  // so the gate only ever ratchets down. No thresholdOverrides: a function over
  // the line gets split into helpers, not exempted.
  //
  // maxCrap is parked at 1000, i.e. off. CRAP (Change Risk Anti-Patterns) is
  // cc^2 * (1 - coverage)^3 + cc — a risk score that multiplies complexity by
  // how untested the function is. With no coverage data it collapses to
  // cc^2 + cc, which is just maxCyclomatic restated, so the default of 30 would
  // silently act as a max-cyclomatic of 5. Once the Coverage gate lands, pass
  // --coverage (Istanbul, not v8) and drop this to 30 for a real risk gate.
  "health": {
    "maxCyclomatic": 5,
    "maxCognitive": 5,
    "maxCrap": 1000
  }
}
