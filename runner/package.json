{
  "name": "@loopcliharness/runner",
  "version": "0.1.0",
  "private": true,
  "description": "Single-session runner: runs one AgentJira node in one fresh headless Claude Code session.",
  "type": "module",
  "scripts": {
    "start": "tsx run-task.ts",
    "judge": "tsx run-judge.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mutation": "stryker run"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
